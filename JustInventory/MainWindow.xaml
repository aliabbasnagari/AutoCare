<Window
    x:Class="JustInventory.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JustInventory"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="bvc" />
        <Style x:Key="popupStyle" TargetType="{x:Type ColumnDefinition}">
            <Style.Triggers>
                <Trigger Property="{Binding ShowSide}" Value="true">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Width"
                                    From="0"
                                    To="200"
                                    Duration="0:0:0.20" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox
                    x:Name="tbSearch"
                    Margin="0,0,10,0"
                    Padding="3"
                    VerticalContentAlignment="Center"
                    FontSize="14" />
                <TextBlock
                    Margin="6,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="DarkGray"
                    IsHitTestVisible="False"
                    Text="Search...">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=tbSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button
                Grid.Column="1"
                Height="30"
                VerticalAlignment="Center"
                Click="Button_Click_1"
                Content="Search" />
        </Grid>


        <Grid Grid.Row="1">
            <DataGrid
                Grid.Column="0"
                CanUserAddRows="False"
                IsReadOnly="True"
                ItemsSource="{Binding CurrentPageItems, Mode=OneWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="50"
                        Binding="{Binding Id}"
                        Header="ID" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Name}"
                        Header="Name" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding PurchasePrice}"
                        Header="Purchase Price" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding RetailPrice}"
                        Header="Retail Price" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Markup, StringFormat=N2}"
                        Header="Markup (%)" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding StockQuantity}"
                        Header="Stock" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding SoldQuantity}"
                        Header="Sold" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Location}"
                        Header="Location" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Description}"
                        Header="Description" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Labels}"
                        Header="Labels" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Tags}"
                        Header="Tags" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding UpdatedOn, StringFormat=\{0:yyyy-MM-dd\}}"
                        Header="Updated On" />
                </DataGrid.Columns>
            </DataGrid>

            <ProgressBar
                x:Name="pbLoading"
                Width="150"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsIndeterminate="True" />
        </Grid>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel LastChildFill="False">
                <Button
                    Click="Button_Click"
                    Content="Prev"
                    DockPanel.Dock="Left" />
                <Button
                    Click="Button_Click"
                    Content="Next"
                    DockPanel.Dock="Right" />
            </DockPanel>
        </Grid>


    </Grid>
</Window>
