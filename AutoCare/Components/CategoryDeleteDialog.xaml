<Window x:Class="AutoCare.Components.CategoryDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCare.Components"
        mc:Ignorable="d"
        Title="Delete Category"
        Height="200"
        Width="300"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app_icon.png"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        MinHeight="200"
        MinWidth="300"
        SizeToContent="WidthAndHeight">
    <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="10">
            <TextBlock Text="Please confirm if you want to delete categories?"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20" />

            <RadioButton  Content="Delete Subcategories"
                          x:Name="rbDelete"
                          VerticalContentAlignment="Center"
                          IsChecked="True" />

            <RadioButton Content="Move Subcategories to Parent"
                         VerticalContentAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="Confirm"
                        Width="80"
                        Margin="5"
                        Click="OkButton_Click" />
                <Button Content="Cancel"
                        Width="80"
                        Margin="5"
                        IsDefault="True"
                        IsCancel="True"
                        Click="CancelButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
