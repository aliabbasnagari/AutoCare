<Window
    x:Class="AutoCare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="clr-namespace:AutoCare.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AutoCare"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AutoCare"
    Width="1080"
    Height="700"
    Icon="/Assets/app_icon.png"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary Source="/Themes/MenuButtonTheme.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Column="0"
            Width="200"
            Background="{StaticResource SecondaryContainer}">


            <Image
                Margin="32"
                HorizontalAlignment="Center"
                Source="/Assets/Images/logo.png" />

            <comp:ButtonNav
                Click="NavigateToPage"
                Content="Home"
                Icon="/Assets/Icons/Home.png"
                IsChecked="True"
                Tag="HomePage" />

            <comp:ButtonNav
                Click="NavigateToPage"
                Content="Inventory"
                Icon="/Assets/Icons/Box.png"
                Tag="InventoryPage" />


            <comp:ButtonNav
                Click="NavigateToPage"
                Content="Sales"
                Icon="/Assets/Icons/Barchart.png"
                Tag="SalesPage" />

            <comp:ButtonNav
                Click="NavigateToPage"
                Content="Categories"
                Icon="/Assets/Icons/Grid.png"
                Tag="CategoriesPage" />

            <comp:ButtonNav
                Click="NavigateToPage"
                Content="Reports"
                Icon="/Assets/Icons/File.png"
                Tag="CategoriesPage" />
        </StackPanel>

        <Frame
            x:Name="rootFrame"
            Grid.Column="1"
            NavigationUIVisibility="Hidden" />

    </Grid>
</Window>
