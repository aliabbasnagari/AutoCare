<Window x:Class="AutoCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCare"
        mc:Ignorable="d"
        Title="AutoCare" Height="450" Width="800"
        Icon="/Assets/img.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="LightGray">
            <Button Content="Home" FontSize="18" FontWeight="Bold" Margin="5" />
            <Button Content="Inventory" FontSize="18" FontWeight="Bold" Margin="5" />
            <Button Content="Sales" FontSize="18" FontWeight="Bold" Margin="5" />
        </StackPanel>

        <Frame x:Name="rootFrame" Grid.Column="1" />

    </Grid>
</Window>
