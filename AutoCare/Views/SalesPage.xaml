<Page
    x:Class="AutoCare.Views.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AutoCare.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SalesPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">



    <Grid>
        <TabControl Grid.Column="0">
            <TabItem Header="New Sale">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Height="40"
                        Margin="5,0"
                        VerticalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox
                                x:Name="tbSearch"
                                Margin="0,0,10,0"
                                Padding="3"
                                VerticalContentAlignment="Center"
                                FontSize="14"
                                GotFocus="tbSearch_TextChanged"
                                TextChanged="tbSearch_TextChanged" />

                            <TextBlock
                                Margin="6,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="DarkGray"
                                IsHitTestVisible="False"
                                Text="Search Item...">

                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=tbSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Stretch"
                            Content="Search" />
                    </Grid>

                    <ListBox
                        x:Name="lbSearch"
                        Grid.Row="1"
                        Width="600"
                        MaxHeight="300"
                        Margin="5,-5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        KeyDown="lbSearch_KeyDown"
                        MouseDoubleClick="lbSearch_MouseDoubleClick"
                        Visibility="Collapsed" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <DataGrid
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                ItemsSource="{Binding Items}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Binding="{Binding ItemId}"
                                        Header="Item ID"
                                        IsReadOnly="True" />

                                    <DataGridTextColumn
                                        Binding="{Binding Price}"
                                        Header="Price"
                                        IsReadOnly="True" />

                                    <DataGridTextColumn Binding="{Binding Quantity}" Header="Quantity" />

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding TotalPrice}"
                                        Header="Total Price"
                                        IsReadOnly="True" />

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="50" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Background="AntiqueWhite" />


                                <Grid Grid.Row="1" Background="Azure">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding SubTotal, StringFormat='Subtotal: {0:C2}'}" />
                                    <TextBox Grid.Row="2" Text="{Binding Discount}" />
                                    <TextBox Grid.Row="1" Text="{Binding Tax}" />
                                    <TextBlock Grid.Row="3" Text="{Binding Total, StringFormat='Total: {0:C2}'}" />
                                </Grid>
                                <StackPanel Grid.Row="2" Background="AntiqueWhite" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

            </TabItem>
            <TabItem Header="Sales" />
        </TabControl>

        <ProgressBar
            x:Name="pbLoading"
            Width="150"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            Visibility="Collapsed" />
    </Grid>
</Page>
