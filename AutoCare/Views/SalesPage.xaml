<Page x:Class="AutoCare.Views.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AutoCare.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="SalesPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="SlidingPanel"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Width="0">
            <local:AddUpdateUser x:Name="aus" />
        </ScrollViewer>

        <TabControl Grid.Column="0">
            <TabItem Header="New Sale">
                <Grid Grid.Row="0"
                      VerticalAlignment="Top"
                      Height="40"
                      Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="tbSearch"
                                 FontSize="14"
                                 Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 Padding="3" />
                        <TextBlock IsHitTestVisible="False"
                                   FontSize="14"
                                   Text="Search..."
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="6,0,0,0"
                                   Foreground="DarkGray">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=tbSearch}"
                                                     Value="">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Content="Search"
                            Height="30"
                            VerticalAlignment="Center"
                            Grid.Column="1" />
                </Grid>
            </TabItem>
            <TabItem Header="Sales">
                <ListView ItemsSource="{Binding FilteredItems, Mode=OneWay}"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Vertical"
                                                Grid.Column="0">
                                        <TextBlock>
                                            <TextBlock.Inlines>
                                                <Run Text="{Binding Name}"
                                                     FontSize="16"
                                                     FontWeight="Bold"
                                                     Foreground="DarkSlateGray" />
                                                <Run Text="{Binding Location, StringFormat=' - [{0}]'}" />
                                            </TextBlock.Inlines>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Description}"
                                                   MaxWidth="250"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,10,0"
                                                   Foreground="DimGray"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical"
                                                Margin="10 0 0 0"
                                                Grid.Column="1">
                                        <TextBlock Text="Purchase Price"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding PurchasePrice, StringFormat='₨{0:N2}'}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical"
                                                Margin="10 0 0 0"
                                                Grid.Column="2">
                                        <TextBlock Text="Retail Price"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding RetailPrice, StringFormat='₨{0:N2}'}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical"
                                                Margin="10 0 0 0"
                                                Grid.Column="3">
                                        <TextBlock Text="Stock"
                                                   FontWeight="Bold"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding StockQuantity}" />
                                    </StackPanel>


                                    <StackPanel Orientation="Vertical"
                                                Margin="10 0 0 0"
                                                Grid.Column="4">
                                        <TextBlock Text="Sold"
                                                   FontWeight="Bold"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding SoldQuantity}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabItem>
        </TabControl>

        <ProgressBar x:Name="pbLoading"
                     IsIndeterminate="True"
                     Width="150"
                     Height="20"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="Collapsed" />
    </Grid>
</Page>
