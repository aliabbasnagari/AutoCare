<Page x:Class="AutoCare.Views.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AutoCare.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="SalesPage">

    <Grid>
        <TabControl Grid.Column="0">
            <TabItem Header="New Sale">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid VerticalAlignment="Center"
                          Height="40"
                          Margin="5,0"
                          Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="tbSearch"
                                     FontSize="14"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"
                                     Padding="3"
                                     TextChanged="tbSearch_TextChanged" />

                            <TextBlock IsHitTestVisible="False"
                                       FontSize="14"
                                       Text="Search Item..."
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="6,0,0,0"
                                       Foreground="DarkGray">

                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=tbSearch}"
                                                         Value="">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Content="Search"
                                VerticalAlignment="Stretch"
                                Grid.Column="1" />


                    </Grid>

                    <ListBox x:Name="lbSearch"
                             Grid.Row="1"
                             Panel.ZIndex="1"
                             Width="600"
                             MaxHeight="300"
                             Margin="5"
                             HorizontalAlignment="Left"
                             Visibility="Collapsed"
                             VerticalAlignment="Top"
                             KeyDown="lbSearch_KeyDown"
                             MouseDoubleClick="lbSearch_MouseDoubleClick" />

                    <Grid Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <ListView x:Name="lvCart">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1"
                                                    BorderBrush="Gray"
                                                    Padding="10"
                                                    Margin="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Item ID:"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="{Binding ItemId}"
                                                               Grid.Column="1" />

                                                    <TextBlock Text="Qty:"
                                                               Grid.Column="2"
                                                               FontWeight="Bold"
                                                               Margin="20,0,0,0" />
                                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="50"
                                                             Grid.Column="3" />

                                                    <StackPanel Grid.ColumnSpan="4"
                                                                Orientation="Horizontal"
                                                                Margin="0,10,0,0">
                                                        <TextBlock Text="Price:"
                                                                   FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Price, StringFormat=C}"
                                                                   Margin="5,0" />

                                                        <TextBlock Text="Total:"
                                                                   FontWeight="Bold"
                                                                   Margin="20,0,0,0" />
                                                        <TextBlock Text="{Binding TotalPrice, StringFormat=C}"
                                                                   Margin="5,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <Grid Grid.Column="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="200" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Background="AntiqueWhite">
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Background="Azure">
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

            </TabItem>
            <TabItem Header="Sales">
            </TabItem>
        </TabControl>

        <ProgressBar x:Name="pbLoading"
                     IsIndeterminate="True"
                     Width="150"
                     Height="20"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="Collapsed" />
    </Grid>
</Page>
