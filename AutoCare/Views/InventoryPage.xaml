<Page
    x:Class="AutoCare.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="clr-namespace:AutoCare.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AutoCare.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="InventoryPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="MintCream"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="bvc" />
        <Style x:Key="popupStyle" TargetType="{x:Type ColumnDefinition}">
            <Style.Triggers>
                <Trigger Property="{Binding ShowSide}" Value="true">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="Width"
                                    From="0"
                                    To="200"
                                    Duration="0:0:0.20" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="5"
                Padding="3"
                Click="Button_Click"
                Content="Add Item" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <!--
            <TextBox x:Name="tbSearch" FontSize="14" Margin="0,0,10,0" VerticalContentAlignment="Center" Grid.Column="0" Padding="3" />
            -->
            <Grid Grid.Column="0">
                <TextBox
                    x:Name="tbSearch"
                    Margin="0,0,10,0"
                    Padding="3"
                    VerticalContentAlignment="Center"
                    FontSize="14" />
                <TextBlock
                    Margin="6,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="DarkGray"
                    IsHitTestVisible="False"
                    Text="Search...">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=tbSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button
                Grid.Column="1"
                Height="30"
                VerticalAlignment="Center"
                Click="Button_Click_1"
                Content="Search" />
        </Grid>

        <comp:Pagination
            x:Name="pagination"
            Grid.Row="2"
            CurrentPage="1"
            PageChanged="pagination_PageChanged"
            TotalPages="33" />


        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                x:Name="SlidingPanel"
                Grid.Column="1"
                Width="0"
                VerticalScrollBarVisibility="Auto">
                <local:AddUpdateUser x:Name="aus" AddUserClick="aus_AddUserClick" />
            </ScrollViewer>

            <TabControl Grid.Column="0">
                <TabItem Header="Classic">
                    <DataGrid
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding CurrentPageItems, Mode=OneWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding Id}"
                                Header="ID" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Name}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding PurchasePrice}"
                                Header="Purchase Price" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding RetailPrice}"
                                Header="Retail Price" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Markup, StringFormat=N2}"
                                Header="Markup (%)" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding StockQuantity}"
                                Header="Stock" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding SoldQuantity}"
                                Header="Sold" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Location}"
                                Header="Location" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Description}"
                                Header="Description" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Labels}"
                                Header="Labels" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Tags}"
                                Header="Tags" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding UpdatedOn, StringFormat=\{0:yyyy-MM-dd\}}"
                                Header="Updated On" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Custom">
                    <ListView HorizontalContentAlignment="Stretch" ItemsSource="{Binding CurrentPageItems, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="5"
                                    Padding="10"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                            <TextBlock>
                                                <TextBlock.Inlines>
                                                    <Run
                                                        FontSize="16"
                                                        FontWeight="Bold"
                                                        Foreground="DarkSlateGray"
                                                        Text="{Binding Name}" />
                                                    <Run Text="{Binding Location, StringFormat=' - [{0}]'}" />
                                                </TextBlock.Inlines>
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Margin="0,5,20,0" Orientation="Vertical">
                                                    <TextBlock FontWeight="Bold" Text="Purchase Price" />
                                                    <TextBlock Text="{Binding PurchasePrice, StringFormat='₨{0:N2}'}" />
                                                </StackPanel>

                                                <StackPanel Margin="0,5,20,0" Orientation="Vertical">
                                                    <TextBlock FontWeight="Bold" Text="Retail Price" />
                                                    <TextBlock Text="{Binding RetailPrice, StringFormat='₨{0:N2}'}" />
                                                </StackPanel>

                                                <StackPanel Margin="0,5,20,0" Orientation="Vertical">
                                                    <TextBlock
                                                        Margin="0,0,10,0"
                                                        FontWeight="Bold"
                                                        Text="Stock" />
                                                    <TextBlock Text="{Binding StockQuantity}" />
                                                </StackPanel>


                                                <StackPanel Margin="0,5,20,0" Orientation="Vertical">
                                                    <TextBlock
                                                        Margin="0,0,10,0"
                                                        FontWeight="Bold"
                                                        Text="Sold" />
                                                    <TextBlock Text="{Binding SoldQuantity}" />
                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>


                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,5,10,0"
                                            HorizontalAlignment="Left"
                                            Foreground="DimGray"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabItem>
            </TabControl>

            <ProgressBar
                x:Name="pbLoading"
                Width="150"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                />
        </Grid>
    </Grid>
</Page>
