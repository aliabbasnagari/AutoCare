<Page x:Class="AutoCare.Views.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AutoCare.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="InventoryPage"
      Background="MintCream">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="bvc" />
        <Style x:Key="popupStyle"
               TargetType="{x:Type ColumnDefinition}">
            <Style.Triggers>
                <Trigger Property="{Binding ShowSide}"
                         Value="true">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 From="0"
                                                 To="200"
                                                 Duration="0:0:0.20" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    HorizontalAlignment="Right">
            <Button Content="Add Item"
                    Click="Button_Click"
                    Padding="3"
                    Margin="5" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <!--
            <TextBox x:Name="tbSearch" FontSize="14" Margin="0,0,10,0" VerticalContentAlignment="Center" Grid.Column="0" Padding="3" />
            -->
            <Grid Grid.Column="0">
                <TextBox x:Name="tbSearch"
                         FontSize="14"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         Padding="3" />
                <TextBlock IsHitTestVisible="False"
                           FontSize="14"
                           Text="Search..."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="6,0,0,0"
                           Foreground="DarkGray">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=tbSearch}"
                                             Value="">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Content="Search"
                    Height="30"
                    VerticalAlignment="Center"
                    Grid.Column="1"
                    Click="Button_Click_1" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="SlidingPanel"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Width="0">
                <local:AddUpdateUser x:Name="aus"
                                     AddUserClick="aus_AddUserClick" />
            </ScrollViewer>

            <TabControl Grid.Column="0">
                <TabItem Header="Classic">
                    <DataGrid ItemsSource="{Binding FilteredItems, Mode=OneWay}"
                              CanUserAddRows="False"
                              IsReadOnly="True" />
                </TabItem>
                <TabItem Header="Custom">
                    <ListView ItemsSource="{Binding FilteredItems, Mode=OneWay}"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray"
                                        BorderThickness="1"
                                        Padding="10"
                                        Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Vertical"
                                                    Grid.Column="0">
                                            <TextBlock>
                                                <TextBlock.Inlines>
                                                    <Run Text="{Binding Name}"
                                                         FontSize="16"
                                                         FontWeight="Bold"
                                                         Foreground="DarkSlateGray" />
                                                    <Run Text="{Binding Location, StringFormat=' - [{0}]'}" />
                                                </TextBlock.Inlines>
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Orientation="Vertical"
                                                            Margin="0, 5, 20, 0">
                                                    <TextBlock Text="Purchase Price"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="{Binding PurchasePrice, StringFormat='₨{0:N2}'}" />
                                                </StackPanel>

                                                <StackPanel Orientation="Vertical"
                                                            Margin="0, 5, 20, 0">
                                                    <TextBlock Text="Retail Price"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="{Binding RetailPrice, StringFormat='₨{0:N2}'}" />
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Vertical"
                                                            Margin="0, 5, 20, 0">
                                                    <TextBlock Text="Stock"
                                                               FontWeight="Bold"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding StockQuantity}" />
                                                </StackPanel>


                                                <StackPanel Orientation="Vertical"
                                                            Margin="0, 5, 20, 0">
                                                    <TextBlock Text="Sold"
                                                               FontWeight="Bold"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding SoldQuantity}" />
                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>


                                        <TextBlock Text="{Binding Description}"
                                                   Grid.Column="1"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,10,0"
                                                   Foreground="DimGray"
                                                   HorizontalAlignment="Left" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabItem>
            </TabControl>

            <ProgressBar x:Name="pbLoading"
                         IsIndeterminate="True"
                         Width="150"
                         Height="20"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
