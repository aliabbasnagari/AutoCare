<Page x:Class="AutoCare.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AutoCare.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="ManageCategoriesPage">

    <Grid Background="Aquamarine"
          HorizontalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Hello"
                       x:Name="parentLink"
                       Grid.Column="0"
                       Margin="0,0,10,0" />

            <TextBox x:Name="newCategory"
                     Grid.Column="1"
                     Margin="0,0,10,0" />

            <Button Content="Add"
                    Grid.Column="2"
                    Click="Button_Click" />
        </Grid>

        <TreeView x:Name="tvCategories"
                  Margin="10"
                  Background="Azure"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  SelectedItemChanged="tvCategories_SelectedItemChanged"
                  Grid.Row="2">

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Subcategories}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   Margin="3,3,20,3"
                                   FontWeight="Bold"
                                   Grid.Column="0" />

                        <Button Content="&#xf2ed;"
                                x:Name="tbFontAwesome"
                                Foreground="Red"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontAwesome}"
                                Tag="{Binding}"
                                Click="tbFontAwesome_Click"
                                Grid.Column="1" />
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Popup x:Name="sure"
               VerticalOffset="200"
               HorizontalOffset="300"
               Focusable="True"
               PopupAnimation="Scroll"
               Height="300"
               Width="150">

            <Grid Background="Wheat">
                <TextBlock Text="asdad"
                           Padding="20"
                           Margin="10" />
            </Grid>
        </Popup>
    </Grid>

</Page>
