<Page x:Class="AutoCare.Views.ManageCategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AutoCare.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManageCategoriesPage">

    <Grid Background="Aquamarine" HorizontalAlignment="Stretch">


        <TreeView x:Name="tvCategories" Margin="10" Background="Azure" 
                  HorizontalAlignment="Stretch" 
                  HorizontalContentAlignment="Stretch">



            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Subcategories}">

                    <StackPanel Background="Bisque" Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding Name}"
            HorizontalAlignment="Stretch"/>

                        <Button 
                                HorizontalAlignment="Right"
         Content="Add" Tag="{Binding Name}" 
         Click="Button_Click"/>
                    </StackPanel>

                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>

</Page>
